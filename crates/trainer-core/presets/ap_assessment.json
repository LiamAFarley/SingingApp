{
  "title": "Absolute pitch assessment",
  "protocol": "ap_assessment",
  "notes": "Holdout stimuli, no feedback, masks between trials. Run it at the start of a session, before hearing any named reference tones.",
  "blocks": [
    {
      "type": "pitch_id",
      "title": "12-class identification",
      "count": 48,
      "assessment": true,
      "tags": ["ap.assessment"],
      "params": { "pool": "holdout", "timbres": ["gm:1"], "octaves": [3, 4, 5], "mask": "random_tones" }
    },
    {
      "type": "pitch_id",
      "title": "Cross-octave identification",
      "count": 24,
      "assessment": true,
      "tags": ["ap.assessment", "ap.id.octave_transfer"],
      "params": { "pool": "holdout", "timbres": ["gm:0", "gm:48"], "octaves": [2, 6], "mask": "random_tones" }
    },
    {
      "type": "pitch_id",
      "title": "Cross-timbre identification",
      "count": 36,
      "assessment": true,
      "tags": ["ap.assessment", "ap.id.timbre_transfer"],
      "params": {
        "pool": "holdout",
        "timbres": ["gm:11", "gm:19", "gm:42", "gm:56", "gm:71", "synth:pulse", "shepard"],
        "octaves": [3, 4, 5],
        "mask": "random_tones"
      }
    },
    {
      "type": "pitch_id",
      "title": "Speeded identification",
      "count": 24,
      "assessment": true,
      "tags": ["ap.assessment", "ap.id.speeded"],
      "params": { "pool": "holdout", "timbres": ["gm:1", "gm:11"], "octaves": [3, 4, 5], "deadline_ms": 1500, "mask": "random_tones" }
    },
    {
      "type": "sing_pitch",
      "title": "No-reference singing",
      "count": 12,
      "assessment": true,
      "tags": ["ap.assessment"],
      "params": { "pre_mask": "random_tones", "reveal_target_after": false }
    },
    {
      "type": "tonal_center_id",
      "title": "Key without a reference",
      "count": 12,
      "assessment": true,
      "tags": ["ap.assessment"],
      "params": { "timbres": ["gm:1"], "modes": ["major", "minor"], "mask": "random_tones" }
    }
  ]
}
